      },
      "item": [
        {
          "id": "16c80d10-085f-48d4-801a-f13082a68f6c",
          "name": "Encode Protein To Tensor",
          "request": {
            "name": "Encode Protein To Tensor",
            "description": {
              "content": "Convert an `ESMProtein` into an `ESMProteinTensor` representation by running the structure tokenizer (and other per-track tokenizers) over the input. The tensor representation is required for low-level forward_and_sample and logits operations.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "encode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"protein\": {\n    \"sequence\": \"<string>\",\n    \"coordinates\": [\n      [\n        [\n          \"<number>\",\n          \"<number>\"\n        ],\n        [\n          \"<number>\",\n          \"<number>\"\n        ]\n      ],\n      [\n        [\n          \"<number>\",\n          \"<number>\"\n        ],\n        [\n          \"<number>\",\n          \"<number>\"\n        ]\n      ]\n    ],\n    \"secondary_structure\": \"<string>\",\n    \"sasa\": [\n      \"<number>\",\n      \"<number>\"\n    ],\n    \"function_annotations\": [\n      \"<object>\",\n      \"<object>\"\n    ],\n    \"ptm\": \"<number>\",\n    \"plddt\": [\n      \"<number>\",\n      \"<number>\"\n    ]\n  }\n}",
