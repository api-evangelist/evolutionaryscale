          "name": "Forward And Sample",
          "request": {
            "name": "Forward And Sample",
            "description": {
              "content": "Executes a single forward pass of ESM3 against a tokenized protein and samples tokens according to a `SamplingConfig`. Intended for power users who need fine-grained control over each iteration (for example, chain-of-thought protein design or custom sampling schedules).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "forward_and_sample"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
