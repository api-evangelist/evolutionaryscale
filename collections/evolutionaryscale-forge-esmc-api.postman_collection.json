          "id": "acaf4d8f-7564-4ee9-ac5a-68a4f912f900",
          "name": "Get ESM C Logits And Embeddings",
          "request": {
            "name": "Get ESM C Logits And Embeddings",
            "description": {
              "content": "Returns per-residue sequence logits and (optionally) embeddings or hidden states for an `ESMProteinTensor` produced by `esmc/encode`. Use for representation learning, classification heads, mutational effect prediction, and similar downstream tasks.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "esmc",
                "logits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"protein_tensor\": {\n    \"sequence\": [\n      \"<integer>\",\n      \"<integer>\"\n    ]\n  },\n  \"config\": {\n    \"sequence\": true,\n    \"return_embeddings\": false,\n    \"return_hidden_states\": false,\n    \"ith_hidden_layer\": -1\n  }\n}",
