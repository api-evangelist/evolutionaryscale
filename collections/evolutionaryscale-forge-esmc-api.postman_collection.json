          "name": "Encode Protein Sequence With ESM C",
          "request": {
            "name": "Encode Protein Sequence With ESM C",
            "description": {
              "content": "Tokenize an `ESMProtein` (sequence track only) into an `ESMProteinTensor` ready for logits / embedding retrieval. ESM C operates over the sequence track exclusively.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "esmc",
                "encode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
