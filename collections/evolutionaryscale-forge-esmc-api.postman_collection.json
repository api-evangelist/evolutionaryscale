  "info": {
    "_postman_id": "e4cedccb-5153-4967-8cdd-e4ca1fb32b46",
    "name": "EvolutionaryScale Forge ESM Cambrian API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Hosted inference API for the ESM Cambrian (ESM C) protein representation learning family. ESM C is a drop-in replacement for ESM2 with comparable or better accuracy at substantially reduced memory footprint. Provides encode and logits operations for sequence embedding workflows. Available in 300M, 600M, and 6B parameter checkpoints.\n\n\nContact Support:\n Name: EvolutionaryScale Forge",
      "type": "text/plain"
    }
  }
