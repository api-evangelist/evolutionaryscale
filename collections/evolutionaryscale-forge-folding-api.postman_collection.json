              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sequence\": \"<string>\",\n  \"model\": \"<string>\",\n  \"msa\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"num_recycles\": 3\n}",
