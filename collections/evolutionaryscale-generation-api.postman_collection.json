          "name": "Generate Protein With ESM3",
          "request": {
            "name": "Generate Protein With ESM3",
            "description": {
              "content": "Iteratively samples tokens on the requested track of an `ESMProtein` input, filling in masked positions until the track is complete. Wraps encode, iterative sampling, and decode in a single call. Returns a fully populated `ESMProtein`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "generate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
